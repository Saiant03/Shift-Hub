{
  "name": "shift-hub-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "scripts": {
    "sync": "node sync-html.js",
    "start": "node sync-html.js && expo start",
    "tunnel": "node sync-html.js && expo start --tunnel ngrok",
    "codespace": "node sync-html.js && EXPO_PACKAGER_PROXY_URL=https://${CODESPACE_NAME}-8081.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN} expo start",
    "android": "node sync-html.js && expo start --android",
    "ios": "node sync-html.js && expo start --ios",
    "web": "node sync-html.js && expo start --web"
  },
  "private": true
}
